# Copy to .env and fill in locally. Never commit real secrets.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
# Native bind. The Docker image/Compose use 0.0.0.0 inside the container and
# publish port 8000 only on the host's 127.0.0.1.
API_HOST=127.0.0.1
API_PORT=8000

# --- Persistence ---
RESEARCH_ASSISTANT_DATABASE_PATH=data/processed/research_assistant.db
# DATABASE_PATH=data/processed/research_assistant.db
# DATABASE_URL=sqlite:///./data/processed/research_assistant.db
RESEARCH_ASSISTANT_MAX_FILE_BYTES=52428800
# MAX_UPLOAD_BYTES=52428800
RESEARCH_ASSISTANT_UPLOAD_DIR=data/uploads
RESEARCH_ASSISTANT_SQLITE_BUSY_TIMEOUT_MS=5000
RESEARCH_ASSISTANT_MAX_QUESTION_CHARS=8000

# --- LLM (OpenAI-compatible Chat Completions; local Ollama is the development default) ---
# RESEARCH_ASSISTANT_LLM_PROVIDER=openai_compatible
# RESEARCH_ASSISTANT_LLM_MODEL=qwen2.5-coder:7b
# LLM_MODEL=qwen2.5-coder:7b
# RESEARCH_ASSISTANT_LLM_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# RESEARCH_ASSISTANT_LLM_TEMPERATURE=0
# RESEARCH_ASSISTANT_LLM_MAX_OUTPUT_TOKENS=512
# RESEARCH_ASSISTANT_LLM_TIMEOUT_SECONDS=120
# LLM_TIMEOUT=120
# RESEARCH_ASSISTANT_LLM_KEEP_ALIVE=
# RESEARCH_ASSISTANT_LLM_REPAIR_MODEL=
# RESEARCH_ASSISTANT_LLM_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Embeddings / rerank ---
# RESEARCH_ASSISTANT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RESEARCH_ASSISTANT_EMBEDDING_DEVICE=auto
# RESEARCH_ASSISTANT_EMBEDDING_BATCH_SIZE=32
# RESEARCH_ASSISTANT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RESEARCH_ASSISTANT_RERANKER_DEVICE=auto
# RESEARCH_ASSISTANT_RERANKER_BATCH_SIZE=8
# RESEARCH_ASSISTANT_RERANK_CANDIDATE_K=20
# RESEARCH_ASSISTANT_RERANK_TOP_K=8
# RESEARCH_ASSISTANT_RERANK_ENABLED=true
# RESEARCH_ASSISTANT_MAX_CONTEXT_TOKENS=1024

# --- Retrieval (do not change unless you intend to retune quality) ---
# RESEARCH_ASSISTANT_TOP_K=5
# RESEARCH_ASSISTANT_BM25_K1=1.2
# RESEARCH_ASSISTANT_BM25_B=0.75
# RESEARCH_ASSISTANT_RRF_K=60
# RESEARCH_ASSISTANT_DENSE_CANDIDATE_K=20
# RESEARCH_ASSISTANT_LEXICAL_CANDIDATE_K=20
# RESEARCH_ASSISTANT_CONVERSATION_WINDOW=4

# --- Vector store (embedded Qdrant path; no Docker required) ---
# RESEARCH_ASSISTANT_VECTOR_INDEX_PATH=data/indexes/qdrant
# The optional Compose qdrant-server profile is for manual API experiments.
# It does not change the application's embedded backend; server URL/key settings
# are not implemented.

# --- HTTP ---
# RESEARCH_ASSISTANT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# RESEARCH_ASSISTANT_HEALTH_PROBE_TIMEOUT_SECONDS=1.5
# RESEARCH_ASSISTANT_LLM_CITATION_REPAIR=true
# RESEARCH_ASSISTANT_LLM_FORMAT_REPAIR=false

# --- Frontend (Vite build) ---
# VITE_API_BASE=
